{
  "permissions": {
    "allow": ["Read", "Edit(src/**)", "Bash(./test.sh)", "Bash(rm:*)", "Bash(ls:*)"],
    "ask":   ["Bash(git push:*)"],
    "deny":  ["Read(./.env)", "Edit(db/migrations/**)", "Bash(curl:*)"]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "*",    "hooks": [ { "type": "command", "command": "python3 .claude/hooks/audit.py" } ] },
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "python3 .claude/hooks/guard.py" } ] }
    ],
    "PostToolUse": [
      { "matcher": "*",    "hooks": [ { "type": "command", "command": "python3 .claude/hooks/audit.py" } ] }
    ]
  }
}
