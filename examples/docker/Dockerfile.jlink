# jlink собирает среду выполнения только из нужных модулей.
FROM eclipse-temurin:21-jdk-alpine AS build
WORKDIR /src
COPY app/App.java .
RUN javac -d out App.java \
 && jlink --add-modules java.base,jdk.httpserver --strip-debug --no-header-files --no-man-pages \
          --compress zip-6 --output /jre

FROM alpine:3.22
COPY --from=build /jre /opt/jre
COPY --from=build /src/out /app
WORKDIR /app
CMD ["/opt/jre/bin/java", "App"]
