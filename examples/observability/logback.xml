<!-- Все сервисы пишут JSON-строки в один файл — как сборщик логов собирает их в одно хранилище. -->
<configuration>
  <appender name="JSON" class="ch.qos.logback.core.FileAppender">
    <file>logs/app.json</file>
    <append>false</append>
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <includeMdcKeyName>requestId</includeMdcKeyName>
      <fieldNames><timestamp>ts</timestamp><version>[ignore]</version><levelValue>[ignore]</levelValue></fieldNames>
    </encoder>
  </appender>
  <root level="INFO"><appender-ref ref="JSON"/></root>
</configuration>
