<configuration>
  <appender name="OUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>  [%-15thread] traceId=%-5X{traceId:-none} %logger{0} %level %msg%n</pattern></encoder>
  </appender>
  <logger name="reactor" level="ERROR"/>
  <root level="INFO"><appender-ref ref="OUT"/></root>
</configuration>
