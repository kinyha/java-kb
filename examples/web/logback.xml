<!-- Демо печатают своё; от фреймворков показываем только ошибки. -->
<configuration>
  <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%level %logger{36} - %msg%n</pattern></encoder>
  </appender>
  <root level="ERROR"><appender-ref ref="console"/></root>
</configuration>
